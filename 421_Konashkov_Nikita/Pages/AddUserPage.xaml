<Page x:Class="_421_Konashkov_Nikita.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_421_Konashkov_Nikita.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавить пользователя">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Labels -->
        <TextBlock Text="Логин" Grid.Row="0" Grid.Column="0" Margin="10,0,0,5" VerticalAlignment="Center"/>
        <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="0" Margin="10,0,0,5" VerticalAlignment="Center"/>
        <TextBlock Text="Роль" Grid.Row="2" Grid.Column="0" Margin="10,0,0,5" VerticalAlignment="Center"/>
        <TextBlock Text="ФИО" Grid.Row="3" Grid.Column="0" Margin="10,0,0,5" VerticalAlignment="Center"/>
        <TextBlock Text="Фото (необязательно)" Grid.Row="4" Grid.Column="0" Margin="10,0,0,5" VerticalAlignment="Center"/>

        <!-- Input Fields with Tooltips -->
        <TextBox x:Name="LoginTextBox" 
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="0" Grid.Column="1" Margin="0,0,10,5" Width="200" HorizontalAlignment="Left"
                 ToolTip="Введите логин пользователя"/>

        <TextBox x:Name="PasswordTextBox" 
                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="1" Grid.Column="1" Margin="0,0,10,5" Width="200" HorizontalAlignment="Left"
                 ToolTip="Введите пароль пользователя"/>

        <ComboBox x:Name="cmbRole" 
                  SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}" 
                  Grid.Row="2" Grid.Column="1" Margin="0,0,10,5" Width="200" HorizontalAlignment="Left"
                  ToolTip="Выберите роль пользователя">
            <ComboBoxItem Content="Администратор" />
            <ComboBoxItem Content="Пользователь" />
        </ComboBox>

        <TextBox x:Name="FioTextBox" 
                 Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="3" Grid.Column="1" Margin="0,0,10,5" Width="200" HorizontalAlignment="Left"
                 ToolTip="Введите ФИО пользователя"/>

        <TextBox x:Name="PhotoTextBox" 
                 Text="{Binding Photo, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="4" Grid.Column="1" Margin="0,0,10,5" Width="200" HorizontalAlignment="Left"
                 ToolTip="Укажите путь к фото (необязательно)"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,9.667,380,149" Grid.Column="1">
            <Button x:Name="ButtonCancel" Content="Отмена" Width="100" Height="30" Margin="0,0,10,0.667" Background="{StaticResource PrimaryBrush2}" Click="ButtonCancel_Click"/>
            <Button x:Name="ButtonSave" Content="Сохранить" Width="100" Height="30" Background="{StaticResource PrimaryBrush2}" Click="ButtonSave_Click"/>
        </StackPanel>
    </Grid>


</Page>
